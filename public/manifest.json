{
    "manifest_version": 3,
    "name": "Babelbird",
    "version": "0.1.0",
    "description": "Translate your current input by pressing Alt+T",
    "permissions": ["storage"],
    "icons": {
        "16": "vite.svg",
        "48": "vite.svg",
        "128": "vite.svg"
    },
    "background": {
        "service_worker": "babelbird-bg.js"
    },
    "commands": {
        "translate-input": {
            "suggested_key": {
                "default": "Alt+T"
            },
            "description": "Translate current input"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["babelbird.js"],
            "run_at": "document_end"
        }
    ]
}
